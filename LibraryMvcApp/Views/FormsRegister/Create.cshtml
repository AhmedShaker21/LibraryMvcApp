@using LibraryMvcApp.ViewModels
@model CreateFormVm

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">رقم الإدارة</label>
        <input asp-for="DepartmentCode"
               class="form-control"
               placeholder="مثال: 50"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">اسم الإجراء</label>
        <input asp-for="ProcedureName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">كود الإجراء</label>
        <input asp-for="ProcedureCode" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">اسم النموذج</label>
        <input asp-for="FormName" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">
        حفظ
    </button>
</form>

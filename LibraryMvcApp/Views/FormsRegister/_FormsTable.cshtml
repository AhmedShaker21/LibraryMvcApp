@model List<LibraryMvcApp.Models.FormEntry>

<table class="table table-bordered table-hover mb-0">
    <thead class="table-primary text-center">
        <tr>
            <th>الإدارة</th>
            <th>رقم النموذج</th>
            <th>اسم الإجراء</th>
            <th>اسم النموذج</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var x in Model.OrderByDescending(f => f.FormNumber))
            {
                <tr>
                    <td class="text-center">@x.DepartmentNo</td>
                    <td class="text-center fw-bold">@x.FullNumber</td>
                    <td>@x.ProcedureName</td>
                    <td>@x.FormName</td>
                    <td class="text-center">

                        <!-- ADD -->
                        <a asp-action="Create"
                           asp-route-departmentNo="@x.DepartmentNo"
                           class="btn btn-info btn-sm">
                            <i class="fas fa-plus"></i>
                        </a>

                        <!-- DELETE -->
                        <form asp-action="DeleteFromAll"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('متأكد من الحذف؟');">
                            <input type="hidden" name="id" value="@x.Id" />
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    لا توجد نماذج
                </td>
            </tr>
        }
    </tbody>
</table>

@model List<LibraryMvcApp.Models.FormEntry>

<table class="table table-bordered table-hover mb-0">
    <thead class="table-primary text-center">
        <tr>
            <th>الإدارة</th>
            <th>رقم النموذج</th>
            <th>اسم الإجراء</th>
            <th>اسم النموذج</th>
            <th>حذف النموذج</th>
            <th>عدد المراجعات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var x in Model.OrderByDescending(f => f.FormNumber))
            {
                <tr>
                    <td class="text-center">@x.DepartmentNo</td>
                    <td class="text-center fw-bold">@x.FullNumber</td>
                    <td>@x.ProcedureName</td>
                    <td>@x.FormName</td>
                    <td class="text-center">

                        @* <!-- ADD -->
                        <a asp-action="Create"
                           asp-route-departmentNo="@x.DepartmentNo"
                           class="btn btn-info btn-sm">
                            <i class="fas fa-plus"></i>
                        </a> *@

                        <form asp-action="DeleteFromAll"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('متأكد من الحذف؟');">
                            <input type="hidden" name="id" value="@x.Id" />
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>

                    </td>
                    <td class="text-center">
                        <form asp-action="UpdateReview"
                              asp-controller="FormsRegister"
                              method="post"
                              class="d-flex justify-content-center gap-2">

                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@x.Id" />

                            <input type="number"
                                   name="review"
                                   value="@x.Review"
                                   min="0"
                                   class="form-control form-control-sm"
                                   style="width:80px;" />

                            <button type="submit"
                                    class="btn btn-sm btn-success">
                                💾
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    لا توجد نماذج
                </td>
            </tr>
        }
    </tbody>
</table>

@model LibraryMvcApp.ViewModels.CreateDepartmentVm

@{
    ViewData["Title"] = "إضافة إدارة";
}

<h2 class="mb-4">➕ إضافة إدارة جديدة</h2>

<form asp-action="Create" method="post" class="card p-4 shadow-sm">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">اسم الإدارة</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">رقم الإدارة (Code)</label>
        <input asp-for="Code" class="form-control" placeholder="مثال: 60" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">رقم البداية للنماذج</label>
        <input asp-for="StartFormNumber" class="form-control" placeholder="مثال: 200" />
        <span asp-validation-for="StartFormNumber" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            حفظ
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            رجوع
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
